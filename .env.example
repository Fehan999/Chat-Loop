# Google AI Studio key for the ChatLoop AI chat (free tier works fine)
# https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# optional, defaults to gemini-flash-latest
VITE_GEMINI_MODEL=

# optional, your own TURN server so calls connect on every network (mobile data, office wifi).
# metered.ca and cloudflare both have free tiers. comma separate several urls
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
