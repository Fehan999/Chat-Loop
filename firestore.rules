rules_version = '2';

// deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // keep this email in sync with ADMIN_EMAIL in src/constants.js
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'business.ehansiddique@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function chatParticipants(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function inChat(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in chatParticipants(chatId);
    }

    // accepting or removing a friend writes to the other person's friends
    // list too, but only ever adds or removes your own uid
    function onlyTouchesMyFriendship() {
      let before = resource.data.get('friends', []).toSet();
      let after = request.resource.data.get('friends', []).toSet();
      return changedKeys().hasOnly(['friends'])
        && after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isMe(userId) && !('banned' in request.resource.data);
      allow update: if isAdmin()
        || (isMe(userId) && !changedKeys().hasAny(['banned', 'banReason', 'bannedAt']))
        || (signedIn() && onlyTouchesMyFriendship());
      allow delete: if isAdmin();
    }

    match /friendRequests/{requestId} {
      // written as two checks so queries filtered on just one side are allowed
      allow read: if isAdmin()
        || (signedIn() && resource.data.senderId == request.auth.uid)
        || (signedIn() && resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid in [resource.data.senderId, resource.data.receiverId];
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      // resource is null for a chat that doesn't exist yet, getOrCreateChat reads first
      allow read: if isAdmin()
        || (signedIn() && (resource == null || request.auth.uid in resource.data.participants));
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();
    }

    match /messages/{chatId}/messages/{messageId} {
      allow read: if inChat(chatId) || isAdmin();
      allow create: if inChat(chatId)
        && (request.resource.data.senderId == request.auth.uid
          || request.resource.data.get('type', '') == 'call');
      // the sender can edit or delete, the other person can react and mark read
      allow update: if isAdmin()
        || (inChat(chatId)
          && (resource.data.senderId == request.auth.uid
            || changedKeys().hasOnly(['reactions', 'read'])));
      allow delete: if inChat(chatId) || isAdmin();
    }

    // admin message count uses a collection group query
    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin();
    }

    match /typing/{chatId} {
      allow read, write: if inChat(chatId);
    }

    match /calls/{callId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.callerId == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid in [resource.data.callerId, resource.data.calleeId];

      match /signals/{signalId} {
        allow read: if signedIn()
          && request.auth.uid in [
            get(/databases/$(database)/documents/calls/$(callId)).data.callerId,
            get(/databases/$(database)/documents/calls/$(callId)).data.calleeId
          ];
        allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      }
    }

    match /aiChats/{userId}/messages/{messageId} {
      allow read, write: if isMe(userId);
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
